<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cesur.dam.inventarioappg1.controllers.MainController">
    <center>
        <VBox alignment="CENTER" prefHeight="500.0" prefWidth="600.0" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="Listado de equipos" />
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="cId" text="Id" />
                    <TableColumn fx:id="cName" text="Nombre" />
                    <TableColumn fx:id="cCategory" text="Categoria" />
                    <TableColumn fx:id="cAvailability" text="Disponibilidad" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <FlowPane alignment="CENTER" hgap="20.0">
                <Button onAction="#newRecord" text="Nuevo" />
                <Button onAction="#logout" text="Cerrar sesión" />
            </FlowPane>
        </VBox>
    </center>
</BorderPane>